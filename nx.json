{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "nxCloudId": "688cf75ad8591f35f82b13bc",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["{projectRoot}/**/*", "{projectRoot}/.env*"],
      "outputs": ["{projectRoot}/dist/**", "!{projectRoot}/dist/cache/**"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^test"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  },
  "generatorOptions": {
    "currentVersionResolver": "git-tag"
  },
  "release": {
    "releaseTagPattern": "{version}",
    "projectsRelationship": "fixed",
    "projects": ["packages/*"],
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github",
        "file": false
      }
    }
  }
}
